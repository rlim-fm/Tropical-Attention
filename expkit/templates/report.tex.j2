<# The campaign report: jinja with LaTeX-safe delimiters (see expkit/latex.py). #>
<# A short main text (setup, the metric grid, the trend overview, the figures the  #>
<# report block asks for); every table sits in the appendix, and each figure's    #>
<# caption names the tables behind it. Prose cites with \autoref.                  #>
\documentclass[10pt]{article}
\usepackage[margin=2.2cm]{geometry}
\usepackage{booktabs,longtable,graphicx,array,xcolor}
\usepackage[hidelinks]{hyperref}
\setlength{\tabcolsep}{4pt}
<# A two-line left-aligned cell without makecell, which the cluster's TeX lacks. #>
\newcommand{\stackcell}[1]{\begin{tabular}[t]{@{}l@{}}#1\end{tabular}}
\newcommand{\ns}[1]{\textcolor{black!45}{#1}}
<% macro facet_cols(row, names) %><% for f in names %><< row[f]|level >> & <% endfor %><% endmacro %>
<% macro facet_head(names) %><% for f in names %>\texttt{<< f|escape >>} & <% endfor %><% endmacro %>
<% macro colspec(n, rest) %><% for _ in range(n) %>l<% endfor %><< rest >><% endmacro %>
<% macro last_table(s) %><% if s.ols %>tab:ols-<< s.metric >><% elif s.paired %>tab:paired-<< s.metric >><% elif s.trend %>tab:trend-<< s.metric >><% elif s.vs_control %>tab:control-<< s.metric >><% else %>tab:summary-<< s.metric >><% endif %><% endmacro %>
<% macro tables_of(s) %><% set last = last_table(s) %><% if last == 'tab:summary-' ~ s.metric %>Table~\ref{tab:summary-<< s.metric >>}<% else %>Tables~\ref{tab:summary-<< s.metric >>}--\ref{<< last >>}<% endif %><% endmacro %>
<% set others = factors|reject('equalto', x_factor)|list %>
<% set has_trend = trend_rows and trend_rows|map(attribute='values')|map('select')|map('list')|select|list %>
\title{<< cfg.experiment|escape >>: << cfg.campaign|escape >>}
\date{<< built|escape >>}
\begin{document}
\maketitle

<% if setup %>
\section{Setup}
<< setup >>

<% endif %>
\section{Results}
<< n_runs >> runs (<< n_seeds >> seeds per cell; << n_diverged >> diverged<< ('; %d never completed, see \\texttt{registry.jsonl}' % failures) if failures else '' >>) under frozen hash \texttt{<< frozen_hash >>}.
<% if has_grid %>
\autoref{fig:metrics} shows every metric against \texttt{<< x_factor|escape >>}<% if others %>, one line per << others|map('escape')|map('replace', '', '')|join(' $\\times$ ') >><% endif %>.
<% endif %>
<% if has_trend %>
\autoref{tab:trend-overview} gives the trend of each metric in << trend_spec.transform|default('')|escape >> \texttt{<< x_factor|escape >>} for each line.
<% endif %>
<% if weight %>
\autoref{fig:weight} shows how large the weighted \texttt{<< weight.curve|escape >>} term is next to \texttt{<< weight.relative_to|escape >>}.
<% endif %>
<% if lengths %>
\autoref{fig:lengths} shows how performance falls off with test length.
<% endif %>
Every number behind the figures is in \autoref{app:tables}.
Cells are compared within a seed: a seed index fixes the data and the initialization.

<% if has_trend %>
<% set ntests = trend_rows|map(attribute='values')|map('select')|map('list')|map('length')|sum %>
\begin{table}[!htbp]
\centering
{\small
\begin{tabular}{l<% for s in sections %>r<% endfor %>}
\toprule
<% for s in sections %> & \stackcell{<< s.label.rsplit(' ', 1)|map('escape')|join('\\\\') >><% if s.path.path == 'rank-based' %>$^\dagger$<% endif %>}<% endfor %>\\
\midrule
<% for row in trend_rows %>
<< row.label|escape >><% for r in row['values'] %> & <% if r is none or r.estimate is none %>--<% elif r.p is not none and r.p < alpha %><< '$\\uparrow$' if r.estimate > 0 else '$\\downarrow$' >>\,<< r.estimate|num(2) >><% else %>\ns{<< r.estimate|num(2) >>}<% endif %><% endfor %>\\
<% endfor %>
\bottomrule
\end{tabular}
}
\caption{The trend of each metric in << trend_spec.transform|default('')|escape >> \texttt{<< x_factor|escape >>}<% if trend_spec.transform == 'log10' %> (levels $\le 0$ left out)<% endif %>, per line of \autoref{fig:metrics}.
Unmarked metrics: the OLS slope per unit of << trend_spec.transform|default('')|escape >> \texttt{<< x_factor|escape >>}, in the metric's units; $^\dagger$: Spearman's $\rho$ (rank-based, as the metric piles up at a bound).
An arrow marks $p < << alpha >>$ and gives the sign; grey is not significant.
The $p$ values are uncorrected: of these << ntests >> tests about << '%.1f'|format(ntests * alpha) >> would pass by chance alone.
CIs and the Jonckheere--Terpstra test per cell: <% for s in sections if s.trend %>\ref{tab:trend-<< s.metric >>}<< ', ' if not loop.last else '' >><% endfor %>.}
\label{tab:trend-overview}
\end{table}
<% endif %>

<% if has_grid %>
\begin{figure}[p]
\centering
\includegraphics[width=\textwidth,height=0.86\textheight,keepaspectratio]{metrics.png}
\caption{Each metric against \texttt{<< x_factor|escape >>}<% if control %> (control: << control.values()|list|first|level >>)<% endif %>: the mean over seeds with its 95\% bootstrap CI shaded; the arrow in each title points to better.
Numbers per cell, against the control, the trend and the paired contrasts:
<% for s in sections %><< s.label|escape >>, << tables_of(s) >><< '; ' if not loop.last else '.' >><% endfor %>}
\label{fig:metrics}
\end{figure}
<% endif %>


<% if weight %>
\begin{figure}[tbp]
\centering
\includegraphics[width=0.85\textwidth]{effective_weight.png}
\caption{How large the regularizer is at the end of training: \texttt{<< weight.scale|escape >>} $\times$ \texttt{<< weight.curve|escape >>} / \texttt{<< weight.relative_to|escape >>}, each the mean of a run's last << weight.last|default(10) >> logged values; the geometric mean over seeds, with the seeds' range shaded. On the dashed line the weighted term equals the loss; far below it the regularizer barely acts. \texttt{<< weight.scale|escape >>} $= 0$ has no term and is left out. Numbers: \autoref{tab:weight}.}
\label{fig:weight}
\end{figure}
<% endif %>

<% if lengths %>
\begin{figure}[tbp]
\centering
\includegraphics[width=\textwidth]{lengths.png}
\caption{How far the models generalize in length, at the smallest, median and largest nonzero \texttt{<< x_factor|escape >>}: each metric against the test length over the longest training length (log axis; tested at << lengths.xs|map('num', 3)|join(', ') >>$\times$)<% if lengths.reference %>; the point at $1\times$ is the in-distribution test set, pooled over every training length<% endif %>. Mean over seeds with its 95\% bootstrap CI. Numbers: \texttt{stats\_lengths.csv}.}
\label{fig:lengths}
\end{figure}
<% endif %>

<% for c in main_curves %>
\begin{figure}[tbp]
\centering
\includegraphics[width=\textwidth]{curve_<< c >>.png}
\caption{\texttt{<< c|escape >>}, the mean over seeds: one panel per level of \texttt{<< x_factor|escape >>}, colours as in \autoref{fig:metrics}. Other curves: \autoref{app:curves}.}
\label{fig:curve-<< c >>}
\end{figure}
<% endfor %>

\clearpage
\appendix
\section{Tables per metric}\label{app:tables}
Each metric's tests take a parametric or a rank-based path, named in each caption: rank-based when more than 20\% of its values sit at a bound.
Comparisons are marked significant at $p < << alpha >>$ after the stated correction.

<% for s in sections %>
\subsection{<< s.label|escape >> (\texttt{<< s.metric|escape >>})}
<% if s.path.reason %>The << s.path.path|escape >> path: << s.path.reason|escape >>.<% endif %>

{\small
\begin{longtable}{<< colspec(factors|length, 'rlrrr') >>}
\caption{<< s.label|escape >> per cell: mean, 95\% bootstrap CI, SD, seeds, diverged runs.}\label{tab:summary-<< s.metric >>}\\
\toprule
<< facet_head(factors) >>mean & 95\% CI & SD & $n$ & div.\\
\midrule
\endhead
<% for r in s.summary %>
<< facet_cols(r, factors) >><< r.mean|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.sd|num(3) >> & << r.n >> & << r.diverged >>\\
<% endfor %>
\bottomrule
\end{longtable}
}

<% if s.vs_control %>
<% set cf = control|list|first %>
{\small
\begin{longtable}{<< colspec(factors|length, 'rrrl') >>}
\caption{<< s.label|escape >>: each level of \texttt{<< cf|escape >>} against its control (<< control[cf]|level >>), within each combination of the other factors. << s.vs_control[0].test_path|escape >>.}\label{tab:control-<< s.metric >>}\\
\toprule
<< facet_head(factors) >>difference & 95\% CI & $p$ & \\
\midrule
\endhead
<% for r in s.vs_control %>
<< facet_cols(r, factors) >><< r.estimate|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.p|pvalue >> & <% if r.p is not none and r.p < alpha %>*<% endif %>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if s.trend %>
<% set tf = factors|reject('equalto', s.trend[0].factor)|list %>
{\small
\begin{longtable}{<< colspec(tf|length, 'rrrrr') >>}
\caption{<< s.label|escape >> against << s.trend[0].transform|escape >> \texttt{<< s.trend[0].factor|escape >>}: << s.trend[0].test_path|escape >>, with the Jonckheere--Terpstra ordered-trend $\tau$ and $p$; uncorrected.}\label{tab:trend-<< s.metric >>}\\
\toprule
<< facet_head(tf) >>estimate & 95\% CI & $p$ & JT $\tau$ & JT $p$\\
\midrule
\endhead
<% for r in s.trend %>
<< facet_cols(r, tf) >><< r.estimate|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.p|pvalue >> & << r.jt_tau|default(none)|num(3) >> & << r.jt_p|default(none)|pvalue >>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if s.paired %>
{\small
\begin{longtable}{lrrrl}
\caption{<< s.label|escape >>: paired contrasts by seed, Holm-corrected across the cells. << s.paired[0].test_path|escape >>.}\label{tab:paired-<< s.metric >>}\\
\toprule
contrast (within) & difference & 95\% CI & $p$ & \\
\midrule
\endhead
<% for r in s.paired %>
\stackcell{<< r.contrast|escape >>\\\footnotesize <% for f in factors if f in r and f not in r.contrast %><< f|escape >>=<< r[f]|level >> <% endfor %>} & << r.estimate|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.p|pvalue >> & <% if r.p is not none and r.p < alpha %>*<% endif %>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if s.ols %>
{\small
\begin{longtable}{p{0.5\textwidth}rrr}
\caption{<< s.label|escape >>: OLS terms (<< s.ols[0].test_path|escape >>).}\label{tab:ols-<< s.metric >>}\\
\toprule
term & estimate & 95\% CI & $p$\\
\midrule
\endhead
<% for r in s.ols %>
\texttt{<< r.term|escape >>} in \texttt{<< r.formula|escape >>} & << r.estimate|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.p|pvalue >>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>
<% endfor %>

<% if weight %>
\section{Size of the regularizer}
{\small
\begin{longtable}{<< colspec(weight['keys']|length, 'rrr') >>}
\caption{\texttt{<< weight.scale|escape >>} $\times$ \texttt{<< weight.curve|escape >>} / \texttt{<< weight.relative_to|escape >>} at the end of training (\autoref{fig:weight}): geometric mean over seeds, smallest and largest seed.}\label{tab:weight}\\
\toprule
<< facet_head(weight['keys']) >>geo.\ mean & min & max\\
\midrule
\endhead
<% for r in weight.rows %>
<< facet_cols(r, weight['keys']) >><< r.gmean|num(3) >> & << r.low|num(3) >> & << r.high|num(3) >>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if curves|reject('in', main_curves)|list %>
\section{Training curves}\label{app:curves}
<% for c in curves if c not in main_curves %>
\begin{figure}[tbp]
\centering
\includegraphics[width=\textwidth]{curve_<< c >>.png}
\caption{\texttt{<< c|escape >>}, the mean over seeds: one panel per level of \texttt{<< x_factor|escape >>}, colours as in \autoref{fig:metrics}.}
\label{fig:curve-<< c >>}
\end{figure}
<% endfor %>
\clearpage
<% else %>
\label{app:curves}
<% endif %>

\section{Configuration}
The base configuration every run shares (frozen hash \texttt{<< frozen_hash >>}); factor levels are in \autoref{tab:summary-<< sections[0].metric if sections else '' >>}.
{\footnotesize
\begin{verbatim}
<% for line in base_lines %>
<< line >>
<% endfor %>
\end{verbatim}
}
Store: \texttt{<< store|display_path|escape >>}.
\end{document}
