Approve: \texttt{expkit approve << flags|escape >>}

\paragraph{The base the grid would run with.}
{\footnotesize
\begin{verbatim}
<% for line in base_lines %>
<< line >>
<% endfor %>
\end{verbatim}
}

<% if sealed_metrics %>
\clearpage
\appendix
\section{Sealed: OOD and test metrics}
\textbf{Read this only after deciding.} These were recorded by the tuning runs but never consulted by the selection. Choosing a value because it looks better here would tune on the test distribution.
{\small
\begin{longtable}{l<% for m in sealed_metrics %>r<% endfor %>}
\caption{Mean of every OOD or test metric per candidate.}\label{tab:sealed}\\
\toprule
candidate<% for m in sealed_metrics %> & \rotatebox{70}{\texttt{<< m|escape >>}}<% endfor %>\\
\midrule
\endhead
<% for r in sealed_means %>
<% if r.selected %>\textbf{<< r.label|escape >>}<% else %><< r.label|escape >><% endif %><% for v in r['values'] %> & << v|num(3) >><% endfor %>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>
\end{document}
