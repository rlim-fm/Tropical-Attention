<# The tuning report: jinja with LaTeX-safe delimiters (see expkit/latex.py). #>
<# The decision comes first; OOD and test metrics only in the sealed appendix after it. #>
\documentclass[10pt]{article}
\usepackage[margin=2.2cm]{geometry}
\usepackage{booktabs,longtable,graphicx,array,xcolor,framed}
\usepackage[hidelinks]{hyperref}
\setlength{\tabcolsep}{4pt}
<% set better = 'lower' if direction == 'min' else 'higher' %>
<% set colors = {'ok': 'green!45!black', 'review': 'orange!85!black', 'do not approve': 'red!75!black'} %>
\title{Tuning report: << cfg.experiment|escape >> / << cfg.campaign|escape >>}
\date{<< built|escape >>}
\begin{document}
\maketitle

\section{Decision}
<% if tuned %>
Approving freezes
<% for t in tuned %>\texttt{<< t.path|escape >>} $=$ << t.value|level >><% if not loop.last %>, <% endif %><% endfor %> into every cell of the grid (frozen hash \texttt{<< frozen_hash >>}).
The experiment YAML has
<% for t in tuned %>\texttt{<< t.path|escape >>} $=$ << t.yaml|level >><% if not loop.last %>, <% endif %><% endfor %> for this campaign.
<% else %>
No candidate was selected, so there is nothing to approve yet.
<% endif %>
<% if frozen_doc %>
\texttt{frozen.yaml} is currently << 'approved' if frozen_doc.approved else 'unapproved' >><% if frozen_doc.tuned %> with << frozen_doc.tuned|string|escape >><% endif %>.
<% endif %>

\paragraph{Selection rule.} The candidate with the << 'lowest' if direction == 'min' else 'highest' >> mean \texttt{<< metric|escape >>} wins, averaged over << cells|length >> cell(s) and << spec.seeds >> tuning seed(s) each (global seed << spec.global_seed >>, disjoint from the grid's << cfg.global_seed >>), across << rows|length >> candidates. A candidate with a missing or diverged run is not eligible.

\begin{framed}
\noindent\textbf{Verdict: \textcolor{<< colors[verdict] >>}{<< verdict|upper|escape >>}}
<% if warning_rows %>
\begin{itemize}\setlength\itemsep{0pt}
<% for w in warning_rows %>
\item \textbf{<< w.level|escape >>}: << w.message|escape >>
<% endfor %>
\end{itemize}
<% else %>

No check fired.
<% endif %>
\end{framed}
\noindent\textbf{block}: do not approve; fix the search and re-run it. \textbf{review}: read the sections below before approving. \textbf{info}: context only.

\section{Search setup}
\begin{itemize}\setlength\itemsep{0pt}
<% for path, values in spec.space.items() %>
\item \texttt{<< path|escape >>} $\in \{$<% for v in values %><< v|level >><% if not loop.last %>, <% endif %><% endfor %>$\}$
<% endfor %>
\item Cells trained (\texttt{tune.only} << spec.only|string|escape >>):
\begin{itemize}\setlength\itemsep{0pt}
<% for c in cells %>
\item \texttt{<< c|escape >>}
<% endfor %>
\end{itemize}
<% if spec.base %>
\item Search-only overrides (never frozen): \texttt{<< spec.base|string|escape >>}. The chosen value was ranked under this budget, not the grid's.
<% endif %>
\end{itemize}

\section{Candidates}
\autoref{tab:candidates} ranks the candidates on \texttt{<< metric|escape >>} (<< better >> is better); \autoref{fig:sensitivity} plots them.
Candidates share seeds, so \autoref{tab:gaps} compares each with the winner run by run (same cell, same seed).

{\small
\begin{longtable}{r<% for k in knobs %>l<% endfor %>rrrlrll}
\caption{Every candidate: rank, runs stored/expected, diverged, mean with 95\% bootstrap CI, SD and range over all its runs.}\label{tab:candidates}\\
\toprule
\# & <% for k in knobs %>\texttt{<< k|escape >>} & <% endfor %>runs & div. & mean & 95\% CI & SD & range & \\
\midrule
\endhead
<% for r in rows %>
<< r.rank if r.rank else '--' >> & <% for k in knobs %><< r['values'][k]|level >> & <% endfor %><< r.runs >>/<< r.expected >> & << r.diverged >> & << r.mean|num >> & [<< r.ci_low|num(3) >>, << r.ci_high|num(3) >>] & << r.sd|num(3) >> & [<< r.min|num(3) >>, << r.max|num(3) >>] & <% if r.selected %>\textbf{selected}<% elif not r.eligible %>ineligible<% endif %>\\
<% endfor %>
\bottomrule
\end{longtable}
}

<% if gaps %>
{\small
\begin{longtable}{lrrlrrrl}
\caption{Each candidate minus the winner on the runs they share, signed so a positive gap is worse than the winner. Worse/better/equal count the runs; $p$ is a two-sided sign test.}\label{tab:gaps}\\
\toprule
candidate & $n$ & gap & 95\% CI & worse & better & equal & $p$\\
\midrule
\endhead
<% for g in gaps %>
\texttt{<< g.label|escape >>} & << g.n >> & << g.mean|num >> & [<< g.ci_low|num(3) >>, << g.ci_high|num(3) >>] & << g.worse >> & << g.better >> & << g.equal >> & << g.p|pvalue >>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if figures.get('sensitivity') %>
\begin{figure}[htbp]
\centering
\includegraphics[width=\textwidth]{<< figures.sensitivity >>}
\caption{\texttt{<< metric|escape >>} per candidate: the mean over every run with a 95\% bootstrap CI (blue), each cell's seed-mean (grey), the selected candidate (red star).}
\label{fig:sensitivity}
\end{figure}
<% endif %>

\section{Per cell}
One value is frozen for every cell, chosen by the mean over cells. \autoref{fig:cells} shows whether the winner is best in each cell or is carried by a few of them.
<% if figures.get('cells') %>
\begin{figure}[htbp]
\centering
\includegraphics[width=\textwidth]{<< figures.cells >>}
\caption{Each cell's seed-mean \texttt{<< metric|escape >>} per candidate, with its rank within the cell (\#1 is best; green is better).}
\label{fig:cells}
\end{figure}
<% endif %>
{\small
\begin{longtable}{ll}
\caption{The best candidate in each cell.}\label{tab:cells}\\
\toprule
cell & best\\
\midrule
\endhead
<% for r in cell_rows %>
\texttt{<< r.cell|escape >>} & << r.best|join(', ')|escape >>\\
<% endfor %>
\bottomrule
\end{longtable}
}

<% if open_metrics %>
\section{Other training-distribution metrics}
Not used for selection; shown so a winner that trades them away is visible.
{\small
\begin{longtable}{l<% for m in open_metrics %>r<% endfor %>}
\caption{Mean of every other in-distribution metric per candidate.}\label{tab:open}\\
\toprule
candidate<% for m in open_metrics %> & \texttt{<< m|escape >>}<% endfor %>\\
\midrule
\endhead
<% for r in open_means %>
<% if r.selected %>\textbf{<< r.label|escape >>}<% else %><< r.label|escape >><% endif %><% for v in r['values'] %> & << v|num(3) >><% endfor %>\\
<% endfor %>
\bottomrule
\end{longtable}
}
<% endif %>

<% if curve_names %>
\section{Training curves}
The mean over every cell and seed of each candidate; the selected candidate in bold red.
<% for name in curve_names %>
\begin{figure}[htbp]
\centering
\includegraphics[width=\textwidth]{tune_curve_<< name >>.png}
\caption{\texttt{<< name|escape >>} per candidate.}
\label{fig:curve-<< name >>}
\end{figure}
<% endfor %>
<% endif %>

\clearpage
\section{Provenance}
{\small
\begin{longtable}{llrrll}
\caption{Each candidate's runs: base hash, runs, total wall time, commits (+ marks a dirty tree), torch.}\label{tab:provenance}\\
\toprule
candidate & hash & runs & wall (s) & commit & torch\\
\midrule
\endhead
<% for p in provenance %>
<< p.label|escape >> & \texttt{<< p.hash >>} & << p.runs >> & << p.wall|num(3) >> & \texttt{<< p.shas|join(', ')|escape >>} & << p.torch|join(', ')|escape >>\\
<% endfor %>
\bottomrule
\end{longtable}
}
\noindent Store: \texttt{<< store|display_path|escape >>}.\\
